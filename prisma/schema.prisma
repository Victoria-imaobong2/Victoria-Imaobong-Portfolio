generator client{
    provider = "prisma-client-js"
}
datasource db{
    provider = "postgresql"
    url = env("DATABASE_URL")
}

model Project{
    id              String   @id @default(uuid())
    title           String
    category        String
    description     String
    techStack       String[]
    githubUrl       String?
    liveUrl         String?
    featured        Boolean @default(false)
    createdAt       DateTime @default(now())
}

model ContactMessage {
    id         String  @id @default(uuid())
    name       String
    email      String
    message    String
    createdAt  DateTime @default(now())
}